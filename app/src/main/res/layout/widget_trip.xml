<?xml version="1.0" encoding="utf-8"?>
<!--
    桌面小组件布局。
    RemoteViews 支持的控件有限，只能用 LinearLayout、TextView、ImageView 这些，
    不能用 Compose，也不能用 ConstraintLayout 的某些特性。
    所以这里用最朴素的 LinearLayout 嵌套，保证各版本系统都能正常渲染。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <!-- 顶部一行：车次 + 交通工具图标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/widget_icon_desc"
            android:src="@drawable/ic_widget_train" />

        <TextView
            android:id="@+id/widget_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 站点行：出发地 → 目的地 -->
    <TextView
        android:id="@+id/widget_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 时间行 -->
    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:maxLines="1" />

    <!-- 倒计时，醒目一点 -->
    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <!-- 没有即将出行的行程时显示这句 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
